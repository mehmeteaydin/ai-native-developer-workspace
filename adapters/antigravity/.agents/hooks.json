{
  "protect-shipped-specs": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/protect-shipped.sh"
          }
        ]
      }
    ]
  },
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/safety-guard.sh"
          }
        ]
      }
    ]
  }
}

