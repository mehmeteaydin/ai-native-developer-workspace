{
  "session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./hooks/session-start.sh"
      }
    ]
  },
  "protect-shipped-specs": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/protect-shipped.sh"
          }
        ]
      }
    ]
  },
  "safety-and-auto-approve": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/safety-guard.sh"
          }
        ]
      }
    ]
  }
}
